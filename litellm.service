[Unit]
Description=LiteLLM Proxy
After=network.target

[Service]
Type=simple
# Update paths to match your system:
ExecStart=/home/petark/.local/bin/litellm --port 4000 --config /home/petark/confg-kiko.yaml
Restart=on-failure
RestartSec=5
Environment=PATH=/home/petark/.local/bin:/usr/local/bin:/usr/bin:/bin
# Load API keys from env file (create ~/.config/litellm/env)
EnvironmentFile=-%h/.config/litellm/env

[Install]
WantedBy=default.target