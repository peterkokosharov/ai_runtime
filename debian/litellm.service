[Unit]
Description=LiteLLM Proxy
After=network.target

[Service]
Type=simple
# Config and binary in ~/.litellm/ directory
ExecStart=%h/.local/bin/litellm --port 4000 --config %h/.litellm/config.yaml
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Load API keys from env file (create ~/.litellm/env):
#   NVIDIA_API_KEY=your_key
#   GOOGLE_API_KEY=your_key
#   etc.
EnvironmentFile=-%h/.litellm/env

[Install]
WantedBy=default.target